{
    "rules": {
        "presence": {
            ".read": true,
            "$uid": {
                ".write": "!newData.exists() || newData.hasChildren(['name', 'color', 'lastSeen'])",
                "lastSeen": {
                    ".validate": "newData.isNumber()"
                }
            }
        },
        "invites": {
            "$uid": {
                ".read": true,
                "$senderUid": {
                    ".write": true,
                    ".validate": "newData.hasChildren(['game', 'mode', 'status'])"
                }
            }
        },
        "lobby": {
            "chat": {
                ".read": true,
                "$msgId": {
                    ".write": "newData.hasChildren(['content', 'uid', 'timestamp'])",
                    ".validate": "newData.child('content').isString() && newData.child('uid').isString()"
                }
            }
        },
        "games": {
            "$gameId": {
                ".read": true,
                ".write": true,
                "global": {
                    "pileColors": {
                        ".write": true
                    },
                    "piecePositions": {
                        ".write": true
                    }
                },
                "chat": {
                    ".read": true,
                    "$chatId": {
                        ".write": true,
                        ".validate": "newData.hasChildren(['content', 'uid'])"
                    }
                },
                "playerData": {
                    "$uid": {
                        ".write": "!data.exists() || data.exists()"
                    }
                },
                "users": {
                    "$uid": {
                        ".write": "!data.exists() || data.exists()"
                    }
                }
            }
        },
        "gameData": {
            "$gameId": {
                ".read": true,
                "events": {
                    "$eventId": {
                        ".write": "!data.exists()",
                        ".validate": "newData.hasChildren(['type', 'payload', 'uid', 'timestamp'])"
                    }
                }
            }
        }
    }
}
