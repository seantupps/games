{
    "database": {
        "rules": "database.rules.emulator.json"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local"
            ]
        }
    ],
    "emulators": {
        "database": {
            "port": 9000,
            "host": "127.0.0.1"
        },
        "functions": {
            "port": 5001,
            "host": "127.0.0.1"
        },
        "ui": {
            "enabled": true,
            "port": 4000,
            "host": "127.0.0.1"
        },
        "singleProjectMode": true
    }
}
